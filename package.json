{
  "name": "@r-huijts/strava-mcp-server",
  "version": "1.2.1",
  "description": "MCP server for Strava API",
  "mcpName": "io.github.r-huijts/strava-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-huijts/strava-mcp"
  },
  "main": "dist/server.js",
  "bin": {
    "strava-mcp-server": "./dist/server.js"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "scripts": {
    "build": "tsc",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "setup-auth": "tsx scripts/setup-auth.ts",
    "test": "vitest run",
    "test:api": "RUN_API_TESTS=true vitest run tests/getActivityStreams.api.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "strava",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "axios": "^1.20.0",
    "dotenv": "^16.3.0",
    "jose": "^6.1.0",
    "open": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^20.19.17",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
